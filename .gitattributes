* text=auto eol=lf
# Retain the user's original supplied bytes, including newlines.
USER_PROPOSAL.md -text whitespace=cr-at-eol

# Keep verified implementation and receipt byte hashes stable across checkouts.
src/** -text whitespace=cr-at-eol
tests/** -text whitespace=cr-at-eol
docs/** -text whitespace=cr-at-eol
receipts/** -text whitespace=cr-at-eol
